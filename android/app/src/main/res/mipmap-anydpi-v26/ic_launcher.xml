<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+).
     The foreground PNG already has a 20 % transparent border on every
     side so the icon content is fully inside Android's safe-zone circle.
     No additional XML inset is needed — adding one would make the icon
     appear too small. Background is the brand dark-navy. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
